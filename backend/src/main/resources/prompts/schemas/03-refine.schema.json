            "type": "STRING",
            "enum": [
              "startup",
              "scaleup",
              "enterprise",
              "agency"
            ]
          }
        },
        "title_keywords": {
          "type": "ARRAY",
          "items": {
            "type": "STRING"
          }
        },
        "exclude_titles": {
          "type": "ARRAY",
          "items": {
            "type": "STRING"
          }
        }
      },
      "required": [
