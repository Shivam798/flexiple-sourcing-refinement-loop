# Copy this file to .env and fill in your key. .env is gitignored and never committed.
#
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# SPRING_PROFILES_ACTIVE=dev

# Retry policy. A 429 waits exactly as long as Gemini's response asks for, bounded by these.
# GEMINI_MAX_ATTEMPTS=3
# GEMINI_MAX_RETRY_WAIT=10s
# GEMINI_RETRY_WAIT_BUDGET=20s

# Token bucket pacing the outbound calls. Defaults suit a free-tier key.
# capacity = largest burst, refill-tokens per refill-period = sustained rate.
# GEMINI_RATE_LIMIT_ENABLED=true
# GEMINI_RATE_LIMIT_CAPACITY=5
# GEMINI_RATE_LIMIT_REFILL_TOKENS=5
# GEMINI_RATE_LIMIT_REFILL_PERIOD=60s
# GEMINI_RATE_LIMIT_MAX_WAIT=20s
